{
  "name": "delivery-note-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format:check": "node scripts/check-format.mjs",
    "format:check:all": "node scripts/check-format.mjs --all",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit --composite false -p tsconfig.node.json",
    "test:quality": "node --test scripts/tests/*.mjs",
    "lint:tools": "eslint scripts eslint.config.js",
    "lint": "node scripts/check-lint.mjs",
    "lint:all": "node scripts/check-lint.mjs --all",
    "check:duplicates": "jscpd src ../delivery_note --format python,typescript,tsx,javascript --reporters console",
    "check:unused": "knip",
    "check:imports": "node scripts/check-imports.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run --maxWorkers=1 --fileParallelism=false"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jscpd": "5.4.0",
    "jsdom": "^29.1.1",
    "knip": "6.39.0",
    "oxc-parser": "0.150.0",
    "oxc-resolver": "11.24.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
